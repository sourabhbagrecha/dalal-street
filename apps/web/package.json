{
  "name": "@monopoly-deal/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "css-audit": "node scripts/css-audit.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monopoly-deal/engine": "workspace:*",
    "@monopoly-deal/shared": "workspace:*",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
