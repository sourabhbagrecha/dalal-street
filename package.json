{
  "name": "monopoly-deal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @monopoly-deal/engine test",
    "dev": "pnpm --parallel --filter @monopoly-deal/web --filter @monopoly-deal/server dev",
    "dev:web": "pnpm --filter @monopoly-deal/web dev",
    "server": "pnpm --filter @monopoly-deal/server dev",
    "verify": "bash verification/verify.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "globals": "^15.14.0"
  }
}
