{
  "name": "monopoly-deal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @monopoly-deal/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @monopoly-deal/engine test && pnpm --filter @monopoly-deal/web test",
    "dev": "pnpm --parallel --filter @monopoly-deal/web --filter @monopoly-deal/server dev",
    "dev:portless": "node scripts/portless-dev.mjs",
    "dev:web":"pnpm --filter @monopoly-deal/web dev",
    "server": "pnpm --filter @monopoly-deal/server dev",
    "verify": "bash verification/verify.sh",
    "e2e": "pnpm --filter @monopoly-deal/verification e2e",
    "e2e:net": "pnpm --filter @monopoly-deal/verification e2e-net",
    "knip": "knip"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "globals": "^15.14.0",
    "knip": "^5.88.1"
  }
}
