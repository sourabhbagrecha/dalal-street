{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/engine": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/server": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "scripts/*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs"]
    },
    "verification": {
      "entry": ["*.ts", "e2e/**/*.spec.ts", "e2e-net/**/*.spec.ts"],
      "project": ["**/*.ts"]
    }
  }
}
